[Unit]
Description=Controle de securite hebdomadaire : mises a jour systeme en attente et failles des paquets pip
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/audit_securite.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Nice=10
StandardOutput=journal
StandardError=journal
