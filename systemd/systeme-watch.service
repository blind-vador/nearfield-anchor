[Unit]
Description=Veille systeme : alimentation, chaleur, USB, horloge, internet, disques, veilles en boucle (veille_systeme.py)
After=network.target sound.target

[Service]
ExecStart=/usr/bin/python3 -u /home/vador/autopilot/pi_console/veille_systeme.py
WorkingDirectory=/home/vador/autopilot/pi_console
User=vador
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
