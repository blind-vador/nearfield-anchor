[Unit]
Description=Veille systeme : alimentation, chaleur, USB, horloge, internet, disques, veilles en boucle (veille_systeme.py)
After=network.target sound.target

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/veille_systeme.py
WorkingDirectory=@BASE@/pi_console
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
