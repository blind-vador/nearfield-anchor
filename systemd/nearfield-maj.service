[Unit]
Description=Mise a jour du scanner depuis le depot git (OTA)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_USER@
Environment=PYTHONPATH="@REPO@/lib:@REPO@/watchers:@REPO@/tools:@REPO@/config:@REPO@/bridge"
ExecStart=/usr/bin/python3 -u @REPO@/tools/nearfield_maj.py
