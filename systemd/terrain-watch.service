[Unit]
Description=Veille terrain : sites militants, Mastodon et canaux Telegram publics, lus a la voix
After=multi-user.target network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/veille_terrain.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
