[Unit]
Description=Preparation des voix Piper a l'avance (touches, phrases fixes, noms de bandes)
After=multi-user.target

[Service]
ExecStart=/usr/bin/python3 -u /home/vador/autopilot/pi_console/voix_preparation.py
User=vador
Nice=19
CPUQuota=150%
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
