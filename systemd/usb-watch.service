[Unit]
Description=Entretien et reparation automatique des peripheriques USB (camera, imprimante, son, radio, clavier)
After=multi-user.target sound.target webcamd.service octoprint.service

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/usb_watch.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
