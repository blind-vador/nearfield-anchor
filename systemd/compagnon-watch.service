[Unit]
Description=Pont machines compagnes (decrire_images, meteor, lora)
After=multi-user.target network-online.target nas-watch.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/compagnon_watch.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
