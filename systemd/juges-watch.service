[Unit]
Description=Passage des sons bruts radio devant tous les decodeurs (juges, en tache de fond)
After=multi-user.target sound.target radio-watch.service

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/juges_watch.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Nice=19
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
