[Unit]
Description=Veille radio automatique (446, aviation, marine VHF)
After=multi-user.target sound.target

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/radio_watch.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
