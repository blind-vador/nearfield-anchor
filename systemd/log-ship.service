[Unit]
Description=Copie continue des logs des watchers vers le NAS (+ extraction des messages decodes)
After=multi-user.target nas-watch.service
Wants=nas-watch.service

[Service]
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/log_ship.py
User=@RUN_USER@
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
