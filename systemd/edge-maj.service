[Unit]
Description=Reparation des voix Microsoft (edge-tts), lancee par un refus 403 pendant la parole
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -u @BASE@/pi_console/edge_maj.py
User=@RUN_USER@
Environment=XDG_RUNTIME_DIR=/run/user/1000
StandardOutput=journal
StandardError=journal
