[Unit]
Description=Console vocale du Pi (tty1, clavier USB + espeak)
After=multi-user.target sound.target
Conflicts=getty@tty1.service

[Service]
User=@RUN_USER@
ExecStart=/usr/bin/python3 -u @BASE@/console/main.py
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=2
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=TERM=linux

[Install]
WantedBy=multi-user.target
